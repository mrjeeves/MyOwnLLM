{
  "name": "myownllm",
  "version": "0.2.19",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -W warnings",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "postinstall": "node -e \"try { require('fs').rmSync('node_modules/.vite', { recursive: true, force: true }) } catch (_) {}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "trystero": "^0.24.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4",
    "@tauri-apps/cli": "^2",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@trystero-p2p/core@0.24.0": "patches/@trystero-p2p__core@0.24.0.patch"
    }
  }
}
