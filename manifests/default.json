    "speak": {
      "label": "Speak",
      "output": "audio",
      "tiers": [
        { "min_vram_gb": 4, "min_ram_gb": 8, "min_unified_ram_gb": 16, "disk_mb": 115, "runtime": "kokoro", "model": "kokoro-82m",                 "fallback": "piper-en-us-lessac-medium" },
        { "min_vram_gb": 0, "min_ram_gb": 2, "min_unified_ram_gb": 4,  "disk_mb": 63,  "runtime": "piper",  "model": "piper-en-us-lessac-medium", "fallback": "piper-en-us-lessac-low"    },
        { "min_vram_gb": 0, "min_ram_gb": 0, "min_unified_ram_gb": 0,  "disk_mb": 28,  "runtime": "piper",  "model": "piper-en-us-lessac-low",    "fallback": "piper-en-us-lessac-low"    }
      ]
    },
    "embed": {
      "label": "Embed",
      "tiers": [
        { "min_vram_gb": 0, "min_ram_gb": 4, "min_unified_ram_gb": 8, "disk_mb": 622, "model": "embeddinggemma",   "fallback": "nomic-embed-text" },
        { "min_vram_gb": 0, "min_ram_gb": 2, "min_unified_ram_gb": 4, "disk_mb": 274, "model": "nomic-embed-text", "fallback": "all-minilm"       },
        { "min_vram_gb": 0, "min_ram_gb": 0, "min_unified_ram_gb": 0, "disk_mb": 46,  "model": "all-minilm",       "fallback": "all-minilm"       }
      ]
    }
  },
  "families": {
    "gemma4": {
      "label": "Gemma 4",
      "description": "Google's general-purpose chat models, pinned to the compact e2b build on every machine — small and fast, so spoken replies come back with the lowest latency even on a big GPU. e2b tool-calls natively; the bigger Gemma 4 tags stay reachable by explicit request.",
      "default_mode": "text",
      "modes": {
        "text": {
          "label": "Text",
          "tiers": [
            { "min_vram_gb": 0, "min_ram_gb": 0, "min_unified_ram_gb": 0, "disk_mb": 5600, "model": "gemma4:e2b", "fallback": "gemma4:e2b" }
          ]
        }
      }
    },
    "qwen3.6": {
      "label": "Qwen 3.6",
      "description": "Alibaba's models — best for math, coding, and conversations in non-English languages.",
      "default_mode": "text",
      "modes": {
        "text": {
          "label": "Text",
          "tiers": [
            { "min_vram_gb": 80, "min_ram_gb": 80, "min_unified_ram_gb": 96, "disk_mb": 74000, "model": "qwen3.5:122b", "fallback": "qwen3.6:35b"  },
            { "min_vram_gb": 28, "min_ram_gb": 28, "min_unified_ram_gb": 36, "disk_mb": 24000, "model": "qwen3.6:35b",  "fallback": "qwen3.6:27b"  },
            { "min_vram_gb": 20, "min_ram_gb": 20, "min_unified_ram_gb": 26, "disk_mb": 17000, "model": "qwen3.6:27b",  "fallback": "qwen3.5:9b"   },
            { "min_vram_gb": 8,  "min_ram_gb": 9,  "min_unified_ram_gb": 12, "disk_mb": 5800,  "model": "qwen3.5:9b",   "fallback": "qwen3.5:4b"   },
            { "min_vram_gb": 4,  "min_ram_gb": 5,  "min_unified_ram_gb": 8,  "disk_mb": 2500,  "model": "qwen3.5:4b",   "fallback": "qwen3.5:2b"   },
            { "min_vram_gb": 2,  "min_ram_gb": 3,  "min_unified_ram_gb": 6,  "disk_mb": 1500,  "model": "qwen3.5:2b",   "fallback": "qwen3.5:0.8b" },
            { "min_vram_gb": 0,  "min_ram_gb": 0,  "min_unified_ram_gb": 0,  "disk_mb": 700,   "model": "qwen3.5:0.8b", "fallback": "qwen3.5:0.8b" }
          ]
        }
