        { "min_vram_gb": 0, "min_ram_gb": 6, "min_unified_ram_gb": 12, "disk_mb": 32, "runtime": "pyannote-diarize", "model": "pyannote-seg-3.0+wespeaker-r34", "fallback": "pyannote-seg-3.0+campp-small" },
        { "min_vram_gb": 0, "min_ram_gb": 0, "min_unified_ram_gb": 0,  "disk_mb": 13, "runtime": "pyannote-diarize", "model": "pyannote-seg-3.0+campp-small",  "fallback": "pyannote-seg-3.0+campp-small" }
      ]
